# --- global ---
# Domain used to derive service hostnames (e.g. omada.<domain>).
BASE_DOMAIN=localhost
# Docker network where nginx talks to downstream services (owned by the proxy cluster).
NGINX_PROXY_NETWORK=web-proxy

# --- omada-controller ---
# Upstream image tag. Use a major or major.minor pin (e.g. 6, 6.3) — never
# `latest`: the maintainer deprecates it and it still points at v5.
OMADA_VERSION=6.3
# User/group IDs the controller runs as.
PUID=1000
PGID=1000
# Timezone (e.g. Europe/Berlin).
TZ=UTC
# Controller ports (defaults match upstream; change only on conflict).
MANAGE_HTTP_PORT=8088
MANAGE_HTTPS_PORT=8043
PORTAL_HTTP_PORT=8088
PORTAL_HTTPS_PORT=8843
# Optional: verbose logs (true/false).
SHOW_SERVER_LOGS=false
SHOW_MONGODB_LOGS=false
# Self-signed TLS opt-in for LAN deployments (proxy variant decides which
# TLS opt-in applies; ACME_HOST is always declared in compose).
OMADA_GEN_SELF_SIGNED_CERT=true
